@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
}
@{
    ViewData["Title"] = "Garage";
}
@section Scripts {
    <script src="~/js/garage.js?v=@StaticHelper.VersionNumber"></script>
    <script src="~/js/settings.js?v=@StaticHelper.VersionNumber"></script>
    <script src="~/js/supplyrecord.js?v=@StaticHelper.VersionNumber"></script>
    <script src="~/lib/drawdown/drawdown.js"></script>
    <script src="~/lib/qrcode/qrcode.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
}
@{
    // Tab definitions shared by the primary bar and its "more" overflow dropdown, in the same
    // order the dropdown lists them (checkNavBarOverflow() in shared.js hides a primary item and
    // reveals its dropdown twin by matching this same id - see docs/execution/PHASE_02.md).
    // Settings is rendered separately in the primary bar (see below) because its ms-auto class
    // depends on its exact DOM position among flex siblings - it must stay positioned after the
    // "more" dropdown <li>, not folded into the same loop as the collapsible items before it.
    var homeNavTabs = new List<(string Id, string Target, string Icon, string Label)>
    {
        ("garage-tab", "garage-tab-pane", "bi-car-front", "Garage"),
    };
    if (config.GetServerEnableShopSupplies())
    {
        homeNavTabs.Add(("supply-tab", "supply-tab-pane", "bi-shop", "Supplies"));
    }
    if (userConfig.ShowCalendar)
    {
        homeNavTabs.Add(("calendar-tab", "calendar-tab-pane", "bi-calendar-week", "Calendar"));
    }
    (string Id, string Target, string Icon, string Label) homeSettingsTab = ("settings-tab", "settings-tab-pane", "bi-gear", "Settings");
}
@section Nav {
    @{ ViewData["UserLanguage"] = userLanguage; }
    <div class="ct-sidebar hideOnPrint" id="appSidebar">
        <div class="ct-sidebar-header ct-wordmark-wrap" style="cursor:pointer;" onclick="returnToGarage()">
            @if (config.GetSmallLogoUrl() == StaticHelper.DefaultSmallLogoPath)
            {
                <span class="ct-wordmark">Car Tracker</span>
            }
            else
            {
                <img src="@config.GetSmallLogoUrl()" class="lubelogger-logo" />
            }
        </div>
        <ul class="nav flex-column ct-sidebar-nav" id="homeTab" role="tablist">
            @await Html.PartialAsync("_SidebarNavList", homeNavTabs)
            @await Html.PartialAsync("_SidebarNavList", new List<(string, string, string, string)> { homeSettingsTab })
        </ul>
        @if (User.IsInRole("CookieAuth") || User.IsInRole("APIAuth"))
        {
            <div class="ct-sidebar-footer dropdown nav-item-persist">
                <a class="ct-sidebar-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false"><i class="bi bi-person"></i><span>@User.Identity.Name</span></a>
                <ul class="dropdown-menu">
                    @if (User.IsInRole(nameof(UserData.IsAdmin)))
                    {
                        <li>
                            <a class="dropdown-item" href="/Admin"><i class="bi bi-people me-2"></i>@translator.Translate(userLanguage, "Admin Panel")</a>
                        </li>
                    }
                    @if (User.IsInRole(nameof(UserData.IsRootUser)))
                    {
                        <li>
                            <button class="dropdown-item" onclick="showRootAccountInformationModal()"><i class="bi bi-person-gear me-2"></i>@translator.Translate(userLanguage, "Profile")</button>
                        </li>
                    }
                    else
                    {
                        <li>
                            <button class="dropdown-item" onclick="showAccountInformationModal()"><i class="bi bi-person-gear me-2"></i>@translator.Translate(userLanguage, "Profile")</button>
                        </li>
                        <li>
                            <button class="dropdown-item" onclick="showHouseholdModal()"><i class="bi bi-house me-2"></i>@translator.Translate(userLanguage, "Household")</button>
                        </li>
                    }
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button class="dropdown-item" onclick="performLogOut()"><i class="bi bi-box-arrow-right me-2"></i>@translator.Translate(userLanguage, "Logout")</button>
                    </li>
                </ul>
            </div>
        }
    </div>
    <!-- Mobile-only top bar (<576px): unchanged trigger for the existing full-screen .lubelogger-mobile-nav drawer below. The sidebar above is desktop-only for this increment - mobile keeps today's behavior exactly, ported in a later increment. -->
    <div class="container-fluid lubelogger-navbar-container frosted hideOnPrint ct-mobile-topbar">
        <div class="row mt-2">
            <div class="d-flex lubelogger-navbar justify-content-between">
                <div class="ct-wordmark-wrap" style="cursor:pointer;" onclick="returnToGarage()">
                    @if (config.GetLogoUrl() == StaticHelper.DefaultLogoPath)
                    {
                        <span class="ct-wordmark">Car Tracker</span>
                    }
                    else
                    {
                        <img src="@config.GetLogoUrl()" class="lubelogger-logo" />
                    }
                </div>
                <div class="lubelogger-navbar-button">
                    <button type="button" class="btn btn-adaptive" onclick="showMobileNav()"><i class="bi bi-list lubelogger-menu-icon"></i></button>
                </div>
            </div>
        </div>
        <hr />
    </div>
}
<div class="lubelogger-mobile-nav" onclick="hideMobileNav()">
    <ul class="navbar-nav" id="homeTab" role="tablist">
        <li class="nav-item d-flex" role="presentation">
            <button class="nav-link flex-grow-1 text-start" id="garage-tab" data-bs-toggle="tab" data-bs-target="#garage-tab-pane" type="button" role="tab"><span class="ms-2 display-3"><i class="bi bi-car-front me-2"></i>@translator.Translate(userLanguage, "Garage")</span></button>
            <button class="nav-link" onclick="hideMobileNav()"><span class="display-3 me-2"><i class="bi bi-x-lg"></i></span></button>
        </li>
        @if(config.GetServerEnableShopSupplies())
        {
            <li class="nav-item d-flex" role="presentation">
                <button class="nav-link flex-grow-1 text-start" id="supply-tab" data-bs-toggle="tab" data-bs-target="#supply-tab-pane" type="button" role="tab"><span class="ms-2 display-3"><i class="bi bi-shop me-2"></i>@translator.Translate(userLanguage, "Supplies")</span></button>
            </li>
        }
        @if(userConfig.ShowCalendar){
            <li class="nav-item d-flex" role="presentation">
                <button class="nav-link flex-grow-1 text-start" id="calendar-tab" data-bs-toggle="tab" data-bs-target="#calendar-tab-pane" type="button" role="tab"><span class="ms-2 display-3"><i class="bi bi-calendar-week me-2"></i>@translator.Translate(userLanguage, "Calendar")</span></button>
            </li>
        }
        <li class="nav-item d-flex" role="presentation">
            <button class="nav-link flex-grow-1 text-start" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings-tab-pane" type="button" role="tab"><span class="ms-2 display-3"><i class="bi bi-gear me-2"></i>@translator.Translate(userLanguage, "Settings")</span></button>
        </li>
        @if (User.IsInRole("CookieAuth") || User.IsInRole("APIAuth"))
        {
            @if (User.IsInRole(nameof(UserData.IsAdmin)))
            {
                <li class="nav-item d-flex" role="presentation">
                    <button class="nav-link flex-grow-1 text-start" onclick="goToAdminPanel()"><span class="display-3 ms-2"><i class="bi bi-people me-2"></i>@translator.Translate(userLanguage, "Admin Panel")</span></button>
                </li>
            }
            @if (User.IsInRole(nameof(UserData.IsRootUser)))
            {
                <li class="nav-item d-flex" role="presentation">
                    <button class="nav-link flex-grow-1 text-start" onclick="showRootAccountInformationModal()"><span class="display-3 ms-2"><i class="bi bi-person-gear me-2"></i>@translator.Translate(userLanguage, "Profile")</span></button>
                </li>
            } else
            {
                <li class="nav-item d-flex" role="presentation">
                    <button class="nav-link flex-grow-1 text-start" onclick="showAccountInformationModal()"><span class="display-3 ms-2"><i class="bi bi-person-gear me-2"></i>@translator.Translate(userLanguage, "Profile")</span></button>
                </li>
                <li class="nav-item d-flex" role="presentation">
                    <button class="nav-link flex-grow-1 text-start" onclick="showHouseholdModal()"><span class="display-3 ms-2"><i class="bi bi-house me-2"></i>@translator.Translate(userLanguage, "Household")</span></button>
                </li>
            }
            <li class="nav-item d-flex" role="presentation">
                <button class="nav-link flex-grow-1 text-start" onclick="performLogOut()"><span class="display-3 ms-2"><i class="bi bi-box-arrow-right me-2"></i>@translator.Translate(userLanguage, "Logout")</span></button>
            </li>
        }
    </ul>
</div>
<div class="container">
    <div class="tab-content" id="homeTab">
        <div class="tab-pane fade" id="garage-tab-pane" role="tabpanel" tabindex="0">
        </div>
        <div class="tab-pane fade" id="supply-tab-pane" role="tabpanel" tabindex="0">
        </div>
        <div class="tab-pane fade" id="calendar-tab-pane" role="tabpanel" tabindex="0">
        </div>
        <div class="tab-pane fade" id="settings-tab-pane" role="tabpanel" tabindex="0">
        </div>
    </div>
</div>

<div class="modal fade" id="addVehicleModal" tabindex="-1" role="dialog" aria-labelledby="addVehicleModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="addVehicleModalContent">
        </div>
    </div>
</div>
<div class="modal fade" id="bulkImportModal" tabindex="-1" role="dialog" aria-labelledby="bulkImportModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="bulkImportModalContent">
        </div>
    </div>
</div>
<div class="modal fade" id="accountInformationModal" tabindex="-1" role="dialog" aria-labelledby="updateAccountModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="accountInformationModalContent">
        </div>
    </div>
</div>
<div class="modal fade" data-bs-focus="false" id="householdModal" tabindex="-1" role="dialog" aria-labelledby="householdModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="householdModalContent">
        </div>
    </div>
</div>
<div class="modal fade" data-bs-focus="false" id="attachmentPreviewModal" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="attachmentPreviewModalLabel">
    <div class="modal-dialog modal-fullscreen" role="document">
        <div class="modal-content frosted" id="attachmentPreviewModalContent">
        </div>
    </div>
</div>
<div class="modal fade" data-bs-focus="false" id="userCollaboratorsModal" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="userCollaboratorsModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="userCollaboratorsModalContent">
        </div>
    </div>
</div>
<div class="modal fade" data-bs-focus="false" id="createApiKeyModal" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="createApiKeyLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="createApiKeyModalContent">
        </div>
    </div>
</div>
<div class="modal fade" data-bs-focus="false" id="userApiKeyModal" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="userApiKeyModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="userApiKeyModalContent">
        </div>
    </div>
</div>
<div class="stickerPrintContainer hideOnPrint">
</div>
<script>
    bindWindowResize();
</script>