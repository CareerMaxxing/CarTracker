@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
}
@model List<GenericReportModel>
@{
    var documentTypesPresent = Model.SelectMany(x => x.Files).Select(x => x.Type).Distinct();
}
<div class="d-flex flex-column vehicleTabPane">
    <div class="row">
        <div class="d-flex justify-content-between">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="badge bg-success">@($"{translator.Translate(userLanguage, "# of Documents")}: {Model.Sum(x => x.Files.Count)}")</span>
                @foreach (DocumentType documentType in documentTypesPresent)
                {
                    <span onclick="filterDocumentsGrid('documents-tab-pane', this)" class="user-select-none rounded-pill badge bg-secondary tagfilter" style="cursor:pointer;"><i class="bi @StaticHelper.GetDocumentTypeIcon(documentType) me-1"></i>@documentType</span>
                }
            </div>
        </div>
    </div>
    @if (Model.Any(x => x.Files.Any()))
    {
        <div class="row mt-2">
            <div class="col-12">
                <div class="documents-grid">
                    @foreach (GenericReportModel reportData in Model)
                    {
                        @foreach (UploadedFiles file in reportData.Files)
                        {
                            <div class="card document-tile user-select-none" data-tags="@file.Type" onclick="openAttachmentPreview('@file.Name', '@file.Location')">
                                <div class="document-tile-thumb">
                                    @if (StaticHelper.GetAttachmentIsImage(file.Location))
                                    {
                                        <img src="@file.Location" loading="lazy" alt="" />
                                    }
                                    else
                                    {
                                        <i class="bi @StaticHelper.GetIconByFileExtension(file.Location)"></i>
                                    }
                                    <span class="badge document-tile-category"><i class="bi @StaticHelper.GetDocumentTypeIcon(file.Type) me-1"></i>@translator.Translate(userLanguage, file.Type.ToString())</span>
                                </div>
                                <div class="document-tile-body">
                                    <div class="document-tile-title text-truncate" title="@file.Name">@file.Name</div>
                                    <small class="document-tile-excerpt text-truncate"><i class="bi @StaticHelper.GetImportModeIcon(reportData.DataType) me-1"></i>@translator.Translate(userLanguage, StaticHelper.GetImportModeName(reportData.DataType, false)) &middot; @reportData.Date.ToShortDateString()</small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="ct-empty-state">
            <i class="bi bi-file-earmark-text"></i>
            <span>@translator.Translate(userLanguage, "No Documents Found")</span>
        </div>
    }
</div>
