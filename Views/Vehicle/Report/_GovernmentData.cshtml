@using CarCareTracker.Helper
@using CarCareTracker.Models
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
    var vehicleId = Model.VehicleId;
    string GetMotResultBadgeClass(string testResult) => testResult == "PASSED" ? "status-badge-success" : "status-badge-danger";
    string GetCommentBadgeClass(DVSAMotComment comment)
    {
        if (comment.Dangerous || comment.Type == "DANGEROUS" || comment.Type == "FAIL" || comment.Type == "MAJOR")
        {
            return "status-badge-danger";
        }
        if (comment.Type == "ADVISORY" || comment.Type == "MINOR")
        {
            return "status-badge-warning";
        }
        return "status-badge-neutral";
    }
    int GetCommentSeverityRank(DVSAMotComment comment) => GetCommentBadgeClass(comment) switch
    {
        "status-badge-danger" => 3,
        "status-badge-warning" => 2,
        _ => 1
    };
    string GetTestYear(string completedDate) => completedDate.Length >= 4 ? completedDate.Substring(0, 4) : completedDate;
    var openAdvisories = Model.MotHistory.MotTests
        .SelectMany(t => t.RfrAndComments.Select(c => new { Test = t, Comment = c }))
        .GroupBy(x => StaticHelper.GetMotAdvisoryKey(vehicleId, x.Comment.Text))
        .Select(g => new
        {
            Key = g.Key,
            WorstComment = g.Select(x => x.Comment).OrderByDescending(GetCommentSeverityRank).First(),
            Years = g.Select(x => GetTestYear(x.Test.CompletedDate)).Distinct().OrderBy(y => y).ToList(),
            AlreadyAdded = Model.ExistingMotPlanKeys.Contains(g.Key),
            IsResolved = Model.ResolvedMotPlanKeys.Contains(g.Key),
            IsIgnored = Model.IgnoredMotPlanKeys.Contains(g.Key)
        })
        .OrderByDescending(g => g.Years.Max())
        .ToList();
    //"addressed" covers both actually-fixed and deliberately-not-worth-fixing - either way it no
    //longer needs the user's attention, which is the point of the summary count.
    var settledCount = openAdvisories.Count(x => x.IsResolved || x.IsIgnored);
}
@model VehicleGovernmentDataViewModel
<div class="d-flex justify-content-between align-items-center">
    <span class="lead text-truncate">@translator.Translate(userLanguage, "Government Data")</span>
    @if (Model.DVLAData.IsMockData)
    {
        <span class="status-badge status-badge-neutral" title="@translator.Translate(userLanguage, "Mocked data - not a real DVLA lookup")">@translator.Translate(userLanguage, "Mock")</span>
    }
</div>
<hr />
@if (!Model.DVLAData.Found)
{
    <div class="ct-empty-state">
        <i class="bi bi-signpost-2"></i>
        <span>@translator.Translate(userLanguage, "Add a license plate to this vehicle to view government data")</span>
    </div>
}
else
{
    <div class="d-flex flex-column gap-1">
        <div class="d-flex justify-content-between align-items-center">
            <span>@translator.Translate(userLanguage, "Tax")</span>
            <span class="status-badge @(Model.DVLAData.TaxStatus == "Taxed" ? "status-badge-success" : (Model.DVLAData.TaxStatus == "SORN" ? "status-badge-neutral" : "status-badge-danger"))">@Model.DVLAData.TaxStatus</span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <span>@translator.Translate(userLanguage, "MOT")</span>
            <span class="status-badge @(Model.DVLAData.MotStatus == "Valid" ? "status-badge-success" : "status-badge-danger")">@Model.DVLAData.MotStatus</span>
        </div>
        <div class="text-body-secondary small">
            @translator.Translate(userLanguage, "MOT Expiry"): @Model.DVLAData.MotExpiryDate<br />
            @translator.Translate(userLanguage, "Tax Due"): @Model.DVLAData.TaxDueDate
        </div>
        @if (Model.MotHistory.Found && Model.MotHistory.MotTests.Any())
        {
            <hr class="my-1" />
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold small">@translator.Translate(userLanguage, "MOT History")</span>
                @if (Model.MotHistory.IsMockData)
                {
                    <span class="status-badge status-badge-neutral" title="@translator.Translate(userLanguage, "Mocked data - not a real DVSA lookup")">@translator.Translate(userLanguage, "Mock")</span>
                }
            </div>
            @if (openAdvisories.Any())
            {
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <span class="small text-body-secondary">@translator.Translate(userLanguage, "Advisories & Failures") (@settledCount/@openAdvisories.Count @translator.Translate(userLanguage, "addressed"))</span>
                    <a class="btn btn-sm btn-outline-secondary" data-vehicle-id="@vehicleId" onclick="importAllMotAdvisoriesToPlanner($(this).data('vehicle-id'))">@translator.Translate(userLanguage, "Import All to Planner")</a>
                </div>
                <ul class="mb-0 ps-3 small">
                    @foreach (var advisory in openAdvisories)
                    {
                        <li class="d-flex justify-content-between align-items-center gap-2 mb-1">
                            <span>
                                <span class="status-badge @GetCommentBadgeClass(advisory.WorstComment)">@advisory.WorstComment.Type</span>
                                @if (advisory.IsResolved || advisory.IsIgnored)
                                {
                                    <s>@advisory.WorstComment.Text</s>
                                }
                                else
                                {
                                    @advisory.WorstComment.Text
                                }
                                <span class="text-body-secondary">(@translator.Translate(userLanguage, "flagged"): @string.Join(", ", advisory.Years))</span>
                            </span>
                            @if (advisory.IsIgnored)
                            {
                                <span class="status-badge status-badge-neutral flex-shrink-0" title="@translator.Translate(userLanguage, "Not significant enough to act on")"><i class="bi bi-eye-slash"></i> @translator.Translate(userLanguage, "Ignored")</span>
                            }
                            else if (advisory.IsResolved)
                            {
                                <span class="status-badge status-badge-success flex-shrink-0" title="@translator.Translate(userLanguage, "Marked resolved in the Planner")"><i class="bi bi-check-circle-fill"></i> @translator.Translate(userLanguage, "Resolved")</span>
                            }
                            else if (advisory.AlreadyAdded)
                            {
                                <span class="d-flex align-items-center gap-1 flex-shrink-0">
                                    <span class="status-badge status-badge-warning" title="@translator.Translate(userLanguage, "In the Planner, not yet marked resolved")"><i class="bi bi-hourglass-split"></i> @translator.Translate(userLanguage, "In Planner")</span>
                                    <a class="btn btn-sm btn-outline-secondary" data-vehicle-id="@vehicleId" data-advisory-text="@advisory.WorstComment.Text" onclick="ignoreMotAdvisory($(this).data('vehicle-id'), $(this).data('advisory-text'), this)" title="@translator.Translate(userLanguage, "Not significant - ignore")"><i class="bi bi-eye-slash"></i></a>
                                </span>
                            }
                            else
                            {
                                <span class="d-flex align-items-center gap-1 flex-shrink-0">
                                    <a class="btn btn-sm btn-outline-primary" data-vehicle-id="@vehicleId" data-advisory-text="@advisory.WorstComment.Text" onclick="addMotAdvisoryToPlanner($(this).data('vehicle-id'), $(this).data('advisory-text'), this)">@translator.Translate(userLanguage, "Add to Planner")</a>
                                    <a class="btn btn-sm btn-outline-secondary" data-vehicle-id="@vehicleId" data-advisory-text="@advisory.WorstComment.Text" onclick="ignoreMotAdvisory($(this).data('vehicle-id'), $(this).data('advisory-text'), this)" title="@translator.Translate(userLanguage, "Not significant - ignore")"><i class="bi bi-eye-slash"></i></a>
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
            <hr class="my-1" />
            <div class="d-flex flex-column gap-2 small">
                @foreach (var test in Model.MotHistory.MotTests.OrderByDescending(x => x.CompletedDate))
                {
                    <div>
                        <div class="d-flex align-items-center gap-1 flex-wrap">
                            <span class="status-badge @GetMotResultBadgeClass(test.TestResult)">@test.TestResult</span>
                            <span class="text-body-secondary">(@test.CompletedDate, @test.OdometerValue @test.OdometerUnit)</span>
                        </div>
                        @if (test.RfrAndComments.Any())
                        {
                            <ul class="mb-0 ps-3">
                                @foreach (var comment in test.RfrAndComments)
                                {
                                    <li>
                                        <span class="status-badge @GetCommentBadgeClass(comment)">@comment.Type</span>
                                        @comment.Text
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
