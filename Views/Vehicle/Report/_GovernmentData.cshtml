@using CarCareTracker.Helper
@using CarCareTracker.Models
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
    string GetMotResultBadgeClass(string testResult) => testResult == "PASSED" ? "status-badge-success" : "status-badge-danger";
    string GetCommentBadgeClass(DVSAMotComment comment)
    {
        if (comment.Dangerous || comment.Type == "DANGEROUS" || comment.Type == "FAIL" || comment.Type == "MAJOR")
        {
            return "status-badge-danger";
        }
        if (comment.Type == "ADVISORY" || comment.Type == "MINOR")
        {
            return "status-badge-warning";
        }
        return "status-badge-neutral";
    }
}
@model VehicleGovernmentDataViewModel
<div class="d-flex justify-content-between align-items-center">
    <span class="lead text-truncate">@translator.Translate(userLanguage, "Government Data")</span>
    @if (Model.DVLAData.IsMockData)
    {
        <span class="status-badge status-badge-neutral" title="@translator.Translate(userLanguage, "Mocked data - not a real DVLA lookup")">@translator.Translate(userLanguage, "Mock")</span>
    }
</div>
<hr />
@if (!Model.DVLAData.Found)
{
    <div class="ct-empty-state">
        <i class="bi bi-signpost-2"></i>
        <span>@translator.Translate(userLanguage, "Add a license plate to this vehicle to view government data")</span>
    </div>
}
else
{
    <div class="d-flex flex-column gap-1">
        <div class="d-flex justify-content-between align-items-center">
            <span>@translator.Translate(userLanguage, "Tax")</span>
            <span class="status-badge @(Model.DVLAData.TaxStatus == "Taxed" ? "status-badge-success" : (Model.DVLAData.TaxStatus == "SORN" ? "status-badge-neutral" : "status-badge-danger"))">@Model.DVLAData.TaxStatus</span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <span>@translator.Translate(userLanguage, "MOT")</span>
            <span class="status-badge @(Model.DVLAData.MotStatus == "Valid" ? "status-badge-success" : "status-badge-danger")">@Model.DVLAData.MotStatus</span>
        </div>
        <div class="text-body-secondary small">
            @translator.Translate(userLanguage, "MOT Expiry"): @Model.DVLAData.MotExpiryDate<br />
            @translator.Translate(userLanguage, "Tax Due"): @Model.DVLAData.TaxDueDate
        </div>
        @{
            var motTestsNewestFirst = Model.MotHistory.MotTests.OrderByDescending(x => x.CompletedDate).ToList();
        }
        @if (Model.MotHistory.Found && motTestsNewestFirst.Any())
        {
            <hr class="my-1" />
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold small">@translator.Translate(userLanguage, "MOT History")</span>
                @if (Model.MotHistory.IsMockData)
                {
                    <span class="status-badge status-badge-neutral" title="@translator.Translate(userLanguage, "Mocked data - not a real DVSA lookup")">@translator.Translate(userLanguage, "Mock")</span>
                }
            </div>
            <div class="d-flex flex-column gap-2 small">
                @foreach (var test in motTestsNewestFirst)
                {
                    <div>
                        <div class="d-flex align-items-center gap-1 flex-wrap">
                            <span class="status-badge @GetMotResultBadgeClass(test.TestResult)">@test.TestResult</span>
                            <span class="text-body-secondary">(@test.CompletedDate, @test.OdometerValue @test.OdometerUnit)</span>
                        </div>
                        @if (test.RfrAndComments.Any())
                        {
                            <ul class="mb-0 ps-3">
                                @foreach (var comment in test.RfrAndComments)
                                {
                                    <li>
                                        <span class="status-badge @GetCommentBadgeClass(comment)">@comment.Type</span>
                                        @comment.Text
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
