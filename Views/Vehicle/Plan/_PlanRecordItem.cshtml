@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
    var hideZero = userConfig.HideZero;
}
@model PlanRecord
<div class="taskCard @(Model.Progress == PlanProgress.Done ? "nodrag" : "") user-select-none mt-2" draggable="@(Model.Progress == PlanProgress.Done ? "false" : "true")" ondragstart="dragStart(event, @Model.Id)" onclick="@(Model.Progress == PlanProgress.Done ? $"deletePlanRecord({Model.Id}, true)" : $"showEditPlanRecordModal({Model.Id})")" oncontextmenu="@($"showPlanTableContextMenu(this, {Model.Id}, '{Model.Progress}')")" onmouseup="stopEvent()" ontouchstart="detectPlanItemLongTouch(this, @Model.Id, '@Model.Progress')" ontouchend="detectPlanItemTouchEndPremature(this)">
    <div class="card-body">
        <div class="d-flex gap-2 align-items-center">
            @if (Model.Progress == PlanProgress.Done || Model.ResolvedDate.HasValue)
            {
                <span class="taskCard-title text-truncate"><s>@Model.Description</s></span>
            } else
            {
                <span class="taskCard-title text-truncate">@Model.Description</span>
            }
        </div>
        <div class="d-flex justify-content-between align-items-center mt-1 flex-wrap gap-1">
            <div class="d-flex align-items-center gap-2">
                @if (Model.ImportMode == ImportMode.ServiceRecord)
                {
                    <i class="bi bi-card-checklist text-secondary" title="@translator.Translate(userLanguage, "Service Records")"></i>
                }
                else if (Model.ImportMode == ImportMode.UpgradeRecord)
                {
                    <i class="bi bi-wrench-adjustable text-secondary" title="@translator.Translate(userLanguage, "Upgrades")"></i>
                }
                else if (Model.ImportMode == ImportMode.RepairRecord)
                {
                    <i class="bi bi-exclamation-octagon text-secondary" title="@translator.Translate(userLanguage, "Repairs")"></i>
                }
                else if (Model.ImportMode == ImportMode.GasRecord)
                {
                    <i class="bi bi-fuel-pump text-secondary" title="@translator.Translate(userLanguage, "Fuel")"></i>
                }
                else if (Model.ImportMode == ImportMode.TaxRecord)
                {
                    <i class="bi bi-currency-dollar text-secondary" title="@translator.Translate(userLanguage, "Taxes")"></i>
                }
                @* Priority only gets a badge when it's off the default (Normal) - the exception is the
                   signal worth surfacing, not the common case; same restraint as the Garage card's
                   spotlight badge only appearing when something actually needs attention. *@
                @if (Model.Priority == PlanPriority.Critical)
                {
                    <span class="status-badge status-badge-danger"><i class="bi bi-fire"></i>@translator.Translate(userLanguage, "Critical")</span>
                }
                else if (Model.Priority == PlanPriority.Low)
                {
                    <span class="status-badge status-badge-neutral"><i class="bi bi-snow"></i>@translator.Translate(userLanguage, "Low")</span>
                }
                @if (Model.ReminderRecordId != default || Model.ReminderRecordIds.Any())
                {
                    <span class="status-badge status-badge-spotlight"><i class="bi bi-bell-fill"></i></span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SourceMotKey))
                {
                    if (Model.ResolvedDate.HasValue)
                    {
                        <a class="status-badge status-badge-success" title="@translator.Translate(userLanguage, "Resolved")" onclick="event.stopPropagation(); unmarkPlanRecordResolved(@Model.Id)"><i class="bi bi-check-circle-fill"></i> @translator.Translate(userLanguage, "Resolved")</a>
                    }
                    else
                    {
                        <a class="status-badge status-badge-neutral" title="@translator.Translate(userLanguage, "Mark Resolved")" onclick="event.stopPropagation(); markPlanRecordResolved(@Model.Id)"><i class="bi bi-check-circle"></i> @translator.Translate(userLanguage, "Mark Resolved")</a>
                    }
                }
            </div>
            <div>
                <span class="text-truncate">@(StaticHelper.HideZeroCost(Model.Cost, hideZero))</span>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="d-flex mt-2 flex-wrap">
                <small class="break-all">@(StaticHelper.TruncateStrings(Model.Notes, 100))</small>
            </div>
        }
    </div>
</div>